# Copy this file to `.env` and fill in your values.
# Never commit the real .env to GitHub!
# Loaded automatically by python-dotenv (included in requirements.txt).

# Random string used to secure login sessions
SECRET_KEY=change-this-to-a-long-random-string

# Admin dashboard password (/admin)
ADMIN_PASSWORD=arjun123

# Where the SQLite database file is stored.
# Leave empty to use ./parlour.db next to app.py.
# On Render with a persistent disk, set it to e.g.: /data/parlour.db
DATABASE_URL=
